pipeline {

    agent any

    stages {

        stage('Checkout') {

            steps {

                echo 'Checking out source code...'

                checkout scm

            }

        }


        stage('Build Docker Image') {

            steps {

                echo 'Building Docker image...'

                sh '''
                    docker build \
                    -f docker/Dockerfile \
                    -t automated-cicd-pipeline:latest .
                '''

            }

        }


        stage('Test Docker Image') {

            steps {

                echo 'Testing Docker image...'

                sh '''
                    docker run -d \
                    --name cicd-test-container \
                    -p 8080:80 \
                    automated-cicd-pipeline:latest
                '''

                sleep 5

                sh '''
                    curl -f http://localhost:8080
                '''

            }

        }


        stage('Cleanup') {

            steps {

                echo 'Cleaning up test container...'

                sh '''
                    docker stop cicd-test-container || true
                    docker rm cicd-test-container || true
                '''

            }

        }


        stage('Deployment Ready') {

            steps {

                echo 'CI/CD pipeline completed successfully.'

            }

        }

    }


    post {

        success {

            echo 'Pipeline completed successfully!'

        }

        failure {

            echo 'Pipeline failed. Check the logs.'

        }

    }

}
